{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rajista-pay",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/p/*", "/t/*"]
  },
  // Receipts, quotes and deposit-address lookups.
  "kv_namespaces": [{ "binding": "PAY", "id": "bc492e5d8b4d4c6c820957be5df709ef" }],
  "observability": { "enabled": true }
}
